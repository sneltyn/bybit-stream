APP_PORT="13000"
NODE_ENV="development"
APP_NAME="bybit-stream"
APP_KEY="bybit-stream"

# NATS connection (comma-separated list of urls)
NATS_SERVERS="nats://127.0.0.1:4222"
NATS_NAME="bybit-stream"
# auth — pick one (or none)
NATS_USER=""
NATS_PASSWORD=""
NATS_TOKEN=""
NATS_CREDS_FILE=""

# NATS reconnect / publish tuning (ms)
NATS_RECONNECT_WAIT_MS="2000"
NATS_RECONNECT_JITTER_MS="500"
NATS_PUBLISH_TIMEOUT_MS="5000"

# JetStream stream — single coarse subject; raw Bybit symbol in payload,
# coins owns Bybit→canonical mapping + category resolution.
NATS_SUBJECT="prices.bybit"
NATS_STREAM_NAME="PRICES"
NATS_STREAM_SUBJECTS="prices.>"
NATS_STREAM_MAX_AGE_MS="300000"
NATS_STREAM_MAX_BYTES="1073741824"
NATS_STREAM_REPLICAS="1"

# Bybit
BYBIT_WS_URL="wss://stream.bybit.com/v5/public/linear"
BYBIT_INSTRUMENTS_URL="https://api.bybit.com/v5/market/instruments-info"
BYBIT_CATEGORY="linear"
BYBIT_PING_INTERVAL_MS="20000"
