{
  "name": "bybit-stream",
  "version": "0.0.2",
  "main": "./dist/server.js",
  "private": true,
  "scripts": {
    "clean": "rimraf dist coverage",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm-run-all clean typecheck",
    "build": "npx tsc",
    "start": "nodemon --exec node ./dist/server.js",
    "dev": "npm-run-all build start",
    "dev:watch": "concurrently \"npm run watch-compile\" \"npm run watch-dev\"",
    "watch-compile": "npx swc src -w --out-dir dist",
    "watch-dev": "nodemon --watch \"dist/**/*\" -e js ./dist/server.js",
    "deploy:pm2:prod": "npm run build && cross-env NODE_ENV=production npx pm2 reload ecosystem.config.js --env production"
  },
  "license": "MIT",
  "engines": {
    "node": ">= 16.x"
  },
  "dependencies": {
    "@sentry/node": "^9.35.0",
    "chalk": "~5.4.1",
    "cors": "^2.8.5",
    "dotenv": "^17.1.0",
    "json-bigint": "^1.0.0",
    "module-alias": "^2.2.2",
    "morgan": "^1.10.0",
    "nats": "^2.29.3",
    "npm-run-all": "^4.1.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "winston": "^3.17.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/json-bigint": "^1.0.3",
    "@types/module-alias": "^2.0.1",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.0.10",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.21.0",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-promise": "^7.2.1",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.8.3"
  },
  "packageManager": "yarn@4.9.4"
}
